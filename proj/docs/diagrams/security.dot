digraph G { rankdir=LR; bgcolor="white"; node [fontname="Arial", fontsize=10, shape=box, style="rounded,filled", fillcolor="#eef3ff"]; edge [fontname="Arial", fontsize=9];
 user [label="Customer / Staff\nBrowser", fillcolor="#fff3cd"]; waf [label="HTTPS (TLS 1.2+)\nWAF / rate limit"]; api [label="Node.js API\nSession token (30-min timeout)\nRBAC + lockout after 5 failures\nInput validation"]; sp [label="Stored procedures\n(atomic, parameterised)\nTransaction + row locks"]; db [label="MySQL\nLeast-privilege 'bank_app'\nImmutable ledger triggers\nAudit log", shape=cylinder, fillcolor="#e2f0d9"]; bk [label="Encrypted backups\n+ DR site", fillcolor="#fde2e2"]; gw [label="Payment gateway\n(UPI/NEFT/IMPS)\n2-factor: PIN + OTP", fillcolor="#fff3cd"];
